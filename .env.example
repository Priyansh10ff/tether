# Postgres. docker compose provides this one; swap for a Supabase/Neon/RDS URL in production.
DATABASE_URL=postgres://tether:tether@localhost:5433/tether

# Dashboard login (single admin for v1).
ADMIN_PASSWORD=change-me

# Secret used to sign dashboard session cookies. Any long random string.
SESSION_SECRET=change-me-too

# Worker tuning
WORKER_CONCURRENCY=8
WORKER_POLL_MS=500
DELIVERY_TIMEOUT_MS=8000

# Circuit breaker
BREAKER_THRESHOLD=10
BREAKER_PROBE_MS=60000

# Retention (npm run retention, e.g. from cron)
RETENTION_BODY_DAYS=7
RETENTION_EVENT_DAYS=30

# No Docker? Use an embedded Postgres instead (single process; the worker then runs inside the app):
# DATABASE_URL=pglite://./.tether-data
# WORKER_INLINE=1

# Abuse limits
MAX_EVENT_BYTES=262144
INGEST_RATE_PER_KEY=1000
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MS=900000
# Set to 0 in production (default there). 1 allows localhost/private endpoint URLs for development.
ALLOW_PRIVATE_ENDPOINTS=1
