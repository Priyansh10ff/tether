# Postgres. docker compose provides this one; swap for a Supabase/Neon/RDS URL in production.
DATABASE_URL=postgres://tether:tether@localhost:5432/tether

# Dashboard login (single admin for v1).
ADMIN_PASSWORD=change-me

# Secret used to sign dashboard session cookies. Any long random string.
SESSION_SECRET=change-me-too

# Worker tuning
WORKER_CONCURRENCY=8
WORKER_POLL_MS=500
DELIVERY_TIMEOUT_MS=8000

# Circuit breaker
BREAKER_THRESHOLD=10
BREAKER_PROBE_MS=60000

# Retention (npm run retention, e.g. from cron)
RETENTION_BODY_DAYS=7
RETENTION_EVENT_DAYS=30
